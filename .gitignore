cat > .gitignore << 'EOF'
# ---- Dependencies ----
node_modules/
frontend/node_modules/
jspm_packages/
.pnp/
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ---- Build output ----
frontend/dist/
frontend/build/
release/
dist/
build/
out/
*.dmg
*.exe
*.AppImage
*.deb
*.snap
*.pkg
*.msi
*.rpm

# ---- Logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.log

# ---- Environment / secrets ----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.pem

# ---- npm/yarn diagnostics ----
.npm
.eslintcache
.stylelintcache
.node_repl_history
*.tsbuildinfo
.cache/
.parcel-cache/

# ---- Coverage / test output ----
coverage/
*.lcov
.nyc_output/

# ---- macOS ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# ---- Windows ----
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---- Linux ----
*~
.directory
.Trash-*

# ---- Editors / IDEs ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- Vite ----
*.local

# ---- Electron-builder working files ----
.electron-builder-cache/
EOF